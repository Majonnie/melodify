.exercise-index.shadow-md.rounded.px-8.pt-6.pb-8.mb-4
  h1.text-center.dark:text-gray-400.mb-4
    = '- All Instruments -'

  .exercise-list.flex.flex-wrap.items-center.justify-around.mb-8
    - if @instruments.any?
      = render 'instruments/table', instruments: @instruments
    - else
      p
        = 'No instrument found ¯\_(ツ)_/¯'


  = link_to 'New Instrument', new_instrument_path, class: 'mr-6 bg-blue-600 hover:bg-blue-800 text-white font-bold py-2 px-4 mt-6 rounded focus:outline-none focus:shadow-outline'