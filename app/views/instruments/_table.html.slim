= turbo_frame_tag 'instrument-index-table', class: "w-full"
  .instrument-table.relative.overflow-x-auto
    .shadow.overflow-hidden.rounded
      table.w-full
        thead.text-xs.text-gray-700.uppercase.bg-gray-50.dark:bg-gray-700.dark:text-gray-400
          tr.w-full
            th#instruments-title.relative.w-min.text-left.px-8.py-3.uppercase.font-semibold.text-sm.hover:cursor-pointer scope='col'
              = sort_link(column: "name", label: "Name", path: "list_instruments_path")
              = sort_indicator(params[:direction]) if params[:column] == 'name'
            th#instruments-created_at.relative.w-min.text-left.px-8.py-3.uppercase.font-semibold.text-sm.hover:cursor-pointer scope='col'
              = sort_link(column: "created_at", label: "Created", path: "list_instruments_path")
              = sort_indicator(params[:direction]) if params[:column] == 'created_at'

        tbody.text-gray-700.dark:text-gray-300
          - instruments.each do |instrument|
            tr.odd:bg-white.odd:dark:bg-gray-900.even:bg-blue-50.even:dark:bg-table-dark-blue scope='row'
              td.text-left.py-3.px-6
                = instrument.name
              td.text-left.py-3.px-6
                = instrument.created_at.strftime('%a %d %b %Y')