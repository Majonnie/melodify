header.w-full.flex.flex-col.justify-between.items-center.dark:bg-gray-800 data-controller="burger_menu"
  .flex.items-center.w-full.justify-self-center.justify-between.items-center.p-6
    .center
      h1.text-left.text-3xl.sm:text-4xl.text-transparent.bg-clip-text.bg-gradient-to-tr.to-cyan-500.from-blue-600
        = 'MELODIFY'

    .right.w-fit.flex.justify-around.items-center
      / Burger menu (user related pages/actions)
      button[data-collapse-toggle="navbar-default" data-action="click->burger_menu#toggleMenu" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600" aria-controls="navbar-default" aria-expanded="false"]
        span.sr-only
          | Open main menu
        svg.w-5.h-5[aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14"]
          path[stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"]

      #navbar-default.hidden.w-full.md:block.md:w-auto
        .user-buttons.w-full.flex.items-center
          = render 'layouts/user_links'

      .text-md.text-center.text-gray-500.ml-6 data-controller="theme"
        button data-action="click->theme#toggleTheme"
          i.fa-solid data-theme-target="themeIcon"

  / Other pages
  nav.w-full.mt-4.text-sm.font-medium.text-center.text-gray-500.border-gray-200.dark:text-gray-400.dark:border-gray-700
    - if current_user
      ul.w_full.flex.justify-around.items-center.dark:text-gray-400
          li.w-1/2.text-center
            = link_to 'Instruments', instruments_path, class: 'w-full inline-block p-4 border-b-2 border-blue-600 text-blue-600 rounded-t-lg hover:text-blue-300 hover:border-blue-300'
          li.w-1/2.text-center
            = link_to 'Exercises', exercises_path, class: 'w-full inline-block p-4 border-b-2 border-blue-600 text-blue-600 rounded-t-lg hover:text-blue-300 hover:border-blue-300'
    - else
      ul.w_full.flex.justify-around.items-center.dark:text-gray-400.border-b-2.border-blue-500


  / Menu (opens when burger menu button is clicked)
  .border-2.border-blue-500.absolute.flex.justify-around.items-center.w-1/2.sm:w-1/3.top-28.right-2.hidden.md:hidden.self-center.justify-self-center.shadow-md.rounded.p-2.bg-white.dark:bg-gray-800  data-burger_menu-target="menu"
    .user-buttons.w-full.flex.flex-col.items-center class="[&>*]:w-11/12 [&>*]:m-2 [&>*]:text-center"
      = render 'layouts/user_links'