header.p-6.w-full.flex.flex-col.justify-between.items-center.border-b-2.border-blue-500.dark:bg-gray-800
  .flex.items-center.w-full.justify-self-center.justify-between
    .center
      h1.text-left.text-3xl.sm:text-4xl.text-transparent.bg-clip-text.bg-gradient-to-tr.to-cyan-500.from-blue-600
        = 'MELODIFY'

    .right.w-1/6.flex.justify-around.items-center
      / User related pages/actions
      .user-buttons
        - if current_user
          = link_to 'My Profile', user_path(current_user), class: 'mx-2 w-full lg:w-auto mb-6 bg-blue-600 hover:bg-blue-800 text-white font-bold py-2 px-4 mt-6 rounded focus:outline-none focus:shadow-outline'
          = button_to 'Logout', destroy_user_session_path, method: :delete, class: 'mx-2 w-full lg:w-auto mb-6 bg-blue-600 hover:bg-blue-800 text-white font-bold py-2 px-4 mt-6 rounded focus:outline-none focus:shadow-outline'
        - else
          = link_to 'Register', new_user_registration_path, class: 'mx-2 w-full lg:w-auto mb-6 bg-blue-600 hover:bg-blue-800 text-white font-bold py-2 px-4 mt-6 rounded focus:outline-none focus:shadow-outline'
          = link_to 'Login', new_user_session_path, class: 'mx-2 w-full lg:w-auto mb-6 bg-blue-600 hover:bg-blue-800 text-white font-bold py-2 px-4 mt-6 rounded focus:outline-none focus:shadow-outline'

      .text-sm.font-medium.text-center.text-gray-500 data-controller="theme"
        button data-action="click->theme#toggleTheme"
          i.fa-solid data-theme-target="themeIcon"

  / Other pages
  nav.w-full.mt-4.text-sm.font-medium.text-center.text-gray-500.border-gray-200.dark:text-gray-400.dark:border-gray-700
    ul.w_full.flex.justify-around.items-center.mb-px.dark:text-gray-400
      - if current_user
        li.w-1/4.text-center
          = link_to 'Instruments', instruments_path, class: 'w-full inline-block p-4 border-b-2 border-blue-600 text-blue-600 rounded-t-lg hover:text-blue-300 hover:border-blue-300'
        li.w-1/4.text-center
          = link_to 'Exercises', exercises_path, class: 'w-full inline-block p-4 border-b-2 border-blue-600 text-blue-600 rounded-t-lg hover:text-blue-300 hover:border-blue-300'