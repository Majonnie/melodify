= turbo_frame_tag 'exercise'
  .exercise-show.shadow-md.rounded.px-8.pt-6.pb-8.mb-4

    h1.tracking-wide.text-2xl.font-bold.tracking-tight.text-gray-900.md:text-3xl.dark:text-gray-400
      span.text-transparent.bg-clip-text.bg-gradient-to-tr.to-blue-500.from-blue-700
        = @exercise.title[0]
      = @exercise.title.slice(1, @exercise.title.length)

    /= turbo_frame_tag "question"
      /= render "exercises/question", instrument: @exercise.instruments.first

    p.mb-6
      i
        = "created by #{@exercise.author.full_name}"

    - if user_signed_in?
      .flex.items-center
        = link_to 'Edit Exercise', edit_exercise_path(@exercise),
                class: 'bg-blue-600 hover:bg-blue-800 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline',
                data: { turbo_frame: 'edit_exercise' }

        / FIXME, fix trash icon styling (hover color and alignment)
        = button_to exercise_path(@exercise),
          method: :delete,
          data: { turbo_confirm: 'Are you sure you want to delete this exercise?',
            turbo_frame: '_top' },
          aria: { label: 'Delete exercise' },
          title: 'Delete exercise' do
            i.fa-solid.fa-trash
