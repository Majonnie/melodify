.exercise-index.shadow-md.rounded.px-8.pt-6.pb-8.mb-4
  h1.text-center
    = '- Avalaible Exercises -'

  .exercise-list.flex.flex-wrap.items-center.justify-around
    - if @exercises.any?
      - @exercises.each do |exercise|
        = render 'exercises/card', exercise: exercise
    - else
      p
        = 'No exercise found ¯\_(ツ)_/¯'


  = link_to 'New Exercise', new_exercise_path, class: 'mr-6 bg-blue-600 hover:bg-blue-800 text-white font-bold py-2 px-4 mt-6 rounded focus:outline-none focus:shadow-outline'